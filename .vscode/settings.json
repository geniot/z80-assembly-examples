{
    "workbench.colorTheme": "Visual Studio Dark",
    "asm-code-lens.assembler": "sjasmplus (z80)",
    "files.associations": {
        "*.{asm,inc,s,----------------------------------------------------}": "asm-z80-sjasmplus",
        "*.{list,lis,lst}": "asm-z80-sjasmplus-list"
    },
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.formatOnType": true,

    

    "actionButtons": {
        "defaultColor": "#ff0034", // Can also use string color names.
        "loadNpmCommands": false, // Disables automatic generation of actions for npm commands.
        "reloadButton": "♻️", // Custom reload button text or icon (default ↻). null value enables automatic reload on configuration change
        "inheritGlobalCommands": false, // In case you use workspace-scope settings, and want to also use User (global) scope settings, you might enable this
        "commands": [
            {
                "cwd": "${fileWorkspaceFolder}/${relativeFileDirname}",
                "name": "Compile",
                "color": "green",
                "singleInstance": true,
                "command": "sjasmplus --sld=main.sld --fullpath main.asm"
            },
            {
                "cwd": "${fileWorkspaceFolder}/${relativeFileDirname}",
                "name": "Debug",
                "color": "green",
                "singleInstance": true,
                "useVsCodeApi": true,
                "command": "workbench.action.debug.restart"
            }
        ]
    }
}